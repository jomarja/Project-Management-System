{
  "info": {
    "name": "Project Management System",
    "description": "Start the application first (http://localhost:8080), then run the whole collection in order. Each request saves the ids it creates into collection variables and checks the response with tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "secondTaskId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "attachmentPath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Projects",
      "description": "CRUD for projects, pagination/sorting and error handling.",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const project = pm.response.json();",
                  "pm.test(\"Project has an id and a createdAt time\", () => {",
                  "    pm.expect(project.id).to.be.a(\"number\");",
                  "    pm.expect(project.createdAt).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"projectId\", project.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "description": "@PostMapping + @Valid @RequestBody. Saves the new id into {{projectId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website\",\n  \"description\": \"Company website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create project - validation error (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Error lists the invalid field\", () => {",
                  "    pm.expect(pm.response.json().errors.name).to.eql(\"Project name is required\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "description": "JSR-303 validation: blank name is rejected with a list of invalid fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Name is missing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get all projects (paged and sorted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Response is a page of projects\", () => {",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body.page.number).to.eql(0);",
                  "    pm.expect(body.page.size).to.eql(5);",
                  "    pm.expect(body.page.totalElements).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=0&size=5&sort=name,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "name,asc"
                }
              ]
            },
            "description": "Server-side pagination and sorting with Pageable: ?page=0&size=5&sort=name,asc"
          }
        },
        {
          "name": "Get project by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Returns the created project\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"projectId\")));",
                  "    pm.expect(pm.response.json().name).to.eql(\"Website\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "@PathVariable example."
          }
        },
        {
          "name": "Update project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Name and description are updated\", () => {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Website (updated)\");",
                  "    pm.expect(pm.response.json().description).to.eql(\"New company website\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "@PutMapping with @PathVariable + @Valid @RequestBody.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website (updated)\",\n  \"description\": \"New company website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get project - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", () => pm.response.to.have.status(404));",
                  "",
                  "pm.test(\"Error explains what was not found\", () => {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"Project not found with id 999999\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "999999"
              ]
            },
            "description": "Missing resources return 404 with a clear message."
          }
        }
      ]
    },
    {
      "name": "2. Tags",
      "description": "Tags are later assigned to tasks (many-to-many).",
      "item": [
        {
          "name": "Create tag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const tag = pm.response.json();",
                  "pm.test(\"Tag has an id, name and color\", () => {",
                  "    pm.expect(tag.id).to.be.a(\"number\");",
                  "    pm.expect(tag.name).to.eql(\"backend\");",
                  "    pm.expect(tag.color).to.eql(\"#FF5733\");",
                  "});",
                  "pm.collectionVariables.set(\"tagId\", tag.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            },
            "description": "Saves the new id into {{tagId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"backend\",\n  \"color\": \"#FF5733\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create tag - invalid color (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Color must be a hex code\", () => {",
                  "    pm.expect(pm.response.json().errors.color).to.eql(\"Color must be a hex code like #FF5733\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            },
            "description": "@Pattern validation on the color field.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"frontend\",\n  \"color\": \"red\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get all tags",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Contains the created tag\", () => {",
                  "    pm.expect(pm.response.json().map(tag => tag.id)).to.include(Number(pm.collectionVariables.get(\"tagId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            },
            "description": "All tags sorted by name (Sort.by(\"name\"))."
          }
        }
      ]
    },
    {
